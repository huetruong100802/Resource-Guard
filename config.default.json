{
  "ram": { "normalAboveGB": 5, "cautionFromGB": 3, "restrictedFromGB": 2 },
  "disk": { "drive": "C", "normalAboveGB": 20, "cautionFromGB": 10 },
  "scan": { "autoRefreshHours": 6, "cpuMaxPct": 40, "maxAgeHours": 12, "minGapMinutes": 10 },
  "inventory": { "roots": ["%USERPROFILE%\\Downloads", "%USERPROFILE%\\Documents", "%USERPROFILE%\\Desktop"], "hiddenRoots": ["%LOCALAPPDATA%", "%APPDATA%"], "hiddenExt": ["db", "sqlite", "sqlite3", "bak", "mdf", "ldf"], "hiddenMinMB": 1, "hiddenMaxDepth": 5, "maxDepth": 12, "maxFiles": 40000, "maxSeconds": 90, "minClusterFiles": 3, "minClusterMB": 50, "keepRecentDays": 30, "compressAfterDays": 90, "installerCleanAfterDays": 30, "tempCleanAfterDays": 14 },
  "retention": { "plansDays": 60, "logDays": 30, "journalMaxKB": 4096 },
  "autonomy": { "promoteMinRuns": 5, "promoteMinDays": 7, "demoteRestoreRate": 0.25, "demoteMinArchives": 4, "demoteFailures": 3, "windowDays": 30 },
  "ledger": { "ttlHours": 24 },
  "lease": { "ttlMin": 180, "reserveTtlMin": 10, "subagentTtlMin": 30, "warmupSec": 90, "deferMaxSec": 20, "lastKnownMaxAgeMin": 30, "agentProcessNames": ["claude", "codex", "node"] },
  "commit": { "restrictedPct": 90, "criticalPct": 97 },
  "estimateGB": { "build": 2.0, "test": 3.0, "subagent": 0.5, "session": 0 },
  "policy": {
    "Normal":     { "heavy": "allow", "maxHeavy": 2, "subagent": "allow", "maxSubagents": 3, "cleanup": "propose" },
    "Caution":    { "heavy": "allow", "maxHeavy": 2, "subagent": "warn",  "maxSubagents": 1, "cleanup": "propose" },
    "Restricted": { "heavy": "allow", "maxHeavy": 1, "subagent": "deny",  "maxSubagents": 0, "cleanup": "approval" },
    "Critical":   { "heavy": "deny",  "maxHeavy": 0, "subagent": "deny",  "maxSubagents": 0, "cleanup": "approval" }
  },
  "ui": { "openAs": "app" },
  "agents": {
    "evaluator": { "provider": "auto", "model": "" },
    "providers": {
      "claude": { "model": "haiku" },
      "codex": { "model": "" },
      "gemini": { "model": "" },
      "ollama": { "baseUrl": "http://localhost:11434", "model": "" },
      "openai": { "baseUrl": "https://api.openai.com/v1", "apiKeyEnv": "OPENAI_API_KEY", "model": "", "responseFormat": "json_schema" }
    },
    "catalog": {
      "claude":   { "label": "Claude Code", "kind": "cli", "cli": "claude", "processNames": ["claude"], "cmdRegex": "@anthropic-ai[\\\\/]claude-code|claude-code|[\\\\/]\\.claude[\\\\/]", "connect": ["hooks", "mcp"], "hooks": "claude", "mcpClient": "claude" },
      "codex":    { "label": "Codex CLI", "kind": "cli", "cli": "codex", "processNames": ["codex"], "cmdRegex": "@openai[\\\\/]codex|[\\\\/]\\.codex[\\\\/]", "connect": ["mcp", "wrapper"], "mcpClient": "codex" },
      "gemini":   { "label": "Gemini CLI", "kind": "cli", "cli": "gemini", "processNames": ["gemini"], "cmdRegex": "@google[\\\\/]gemini-cli|gemini-cli[\\\\/]", "connect": ["mcp", "hooks", "wrapper"], "hooks": "gemini", "mcpClient": "gemini" },
      "cursor":   { "label": "Cursor", "kind": "ide", "cli": "cursor-agent", "processNames": ["cursor-agent"], "connect": ["mcp", "hooks"], "hooks": "cursor", "mcpClient": "cursor" },
      "copilot":  { "label": "GitHub Copilot CLI", "kind": "cli", "cli": "copilot", "processNames": ["copilot"], "cmdRegex": "@github[\\\\/]copilot", "connect": ["mcp", "wrapper"], "mcpClient": "copilot" },
      "vscode":   { "label": "VS Code (Copilot Chat, Cline, Roo…)", "kind": "ide", "cli": "code", "processNames": [], "connect": ["mcp"], "mcpClient": "visual studio code|vscode|cline|roo" },
      "windsurf": { "label": "Windsurf", "kind": "ide", "cli": "windsurf", "processNames": [], "connect": ["mcp"], "mcpClient": "windsurf" },
      "opencode": { "label": "opencode", "kind": "cli", "cli": "opencode", "processNames": ["opencode"], "cmdRegex": "opencode-ai|[\\\\/]opencode[\\\\/]", "connect": ["mcp", "wrapper"], "mcpClient": "opencode" },
      "goose":    { "label": "Goose", "kind": "cli", "cli": "goose", "processNames": ["goose", "goosed"], "connect": ["mcp", "wrapper"], "mcpClient": "goose" },
      "aider":    { "label": "Aider", "kind": "cli", "cli": "aider", "processNames": ["aider"], "cmdRegex": "[\\\\/]aider(\\.exe)?\\b|aider[\\\\/]__main__|-m\\s+aider\\b", "connect": ["wrapper"] },
      "ollama":   { "label": "Ollama (model chạy trên máy)", "kind": "runtime", "cli": "ollama", "processNames": ["ollama", "ollama app", "ollama_llama_server"], "connect": [], "note": "Không phải agent: là nơi chạy model cục bộ, thường ngốn nhiều RAM. Có thể dùng làm nhà cung cấp đánh giá (dữ liệu không rời máy)." }
    }
  },
  "agentCmdRegex":"@anthropic-ai[\\\\/]claude-code|@openai[\\\\/]codex|claude-code|[\\\\/]\\.claude[\\\\/]|[\\\\/]\\.codex[\\\\/]",
  "groups": {
    "agent": ["claude*", "codex*"],
    "infra": ["sqlservr", "docker*", "com.docker*", "vmmem*", "wsl*", "vmwp", "vmcompute"],
    "test":  ["testhost*", "vstest*", "playwright*"],
    "build": ["dotnet", "msbuild", "vbcscompiler", "csc", "tsc"],
    "dev":   ["node", "ng", "npm", "npx", "pnpm", "vite", "sqlcmd", "ssms"]
  },
  "heavy": [
    { "name": "dotnet", "cmdRegex": "\\b(build|test|publish|restore|msbuild|pack)\\b" },
    { "name": "msbuild" },
    { "name": "testhost*" },
    { "name": "node", "cmdRegex": "(ng(\\.js)?\"?\\s+build|vite(\\.js)?\"?\\s+build|\\bngc\\b|\\btsc\\b|webpack)" }
  ],
  "heavyExcludeCmdRegex": "nodemode|VBCSCompiler|MSBuildTaskHost|build-server|--version",
  "kill": { "allowedGroups": ["build", "test", "dev"], "allowedRoles": ["build", "test", "devserver", "packagemgr", "compiler", "langserver", "runtime-app"] },
  "identity": {
    "launchers": [
      { "name": "code", "label": "VS Code" },
      { "name": "cursor", "label": "Cursor" },
      { "name": "devenv", "label": "Visual Studio" },
      { "name": "rider64", "label": "Rider" },
      { "name": "windowsterminal", "label": "Windows Terminal" },
      { "name": "explorer", "label": "Explorer" },
      { "name": "claude", "label": "Claude Code" },
      { "name": "codex", "label": "Codex" }
    ],
    "rules": [
      { "name": "powershell|pwsh", "cmdRegex": "rg-(server|scan|watcher|agent|auto|cleanup|elevated-clean|proc|insight)\\.ps1|resource-manager\\.ps1", "role": "system", "title": "Resource Guard", "what": "Chính trợ lý quản lý tài nguyên này" },
      { "name": "dotnet", "cmdRegex": "MSBuild\\.dll.*nodeReuse|/nodemode", "role": "build", "title": "Nút build chờ sẵn", "what": "Tiến trình MSBuild giữ lại để lần build sau nhanh hơn" },
      { "name": "dotnet", "cmdRegex": "\\s(?:build|msbuild|pack)(?:\\s|$)", "role": "build", "title": "Build .NET", "what": "Đang build dự án {project}" },
      { "name": "dotnet", "cmdRegex": "\\spublish(?:\\s|$)", "role": "build", "title": "Publish .NET", "what": "Đang publish dự án {project}" },
      { "name": "dotnet", "cmdRegex": "\\stest(?:\\s|$)", "role": "test", "title": "Test .NET", "what": "Đang chạy test của dự án {project}" },
      { "name": "dotnet", "cmdRegex": "\\swatch(?:\\s|$)", "role": "devserver", "title": "dotnet watch", "what": "Đang chạy và tự biên dịch lại dự án {project}" },
      { "name": "dotnet", "cmdRegex": "\\srestore(?:\\s|$)", "role": "packagemgr", "title": "Khôi phục gói NuGet", "what": "Đang tải gói NuGet cho dự án {project}" },
      { "name": "dotnet", "cmdRegex": "\\srun(?:\\s|$)", "role": "runtime-app", "title": "Chạy ứng dụng .NET", "what": "Đang chạy dự án {project}" },
      { "name": "dotnet", "cmdRegex": "([^\\\\/\"\\s]+\\.dll)", "role": "runtime-app", "title": "Ứng dụng .NET", "what": "Đang chạy {arg}" },
      { "name": "vbcscompiler", "role": "compiler", "title": "Trình biên dịch C# chạy nền", "what": "Giữ trình biên dịch C# sẵn để build nhanh hơn" },
      { "name": "msbuild", "role": "build", "title": "MSBuild", "what": "Đang build dự án {project}" },
      { "name": "testhost*|vstest*", "role": "test", "title": "Chạy test .NET", "what": "Tiến trình thực thi test của dự án {project}" },
      { "name": "playwright*", "role": "test", "title": "Playwright", "what": "Đang chạy kiểm thử trình duyệt" },
      { "name": "node|ng", "cmdRegex": "ng(?:\\.js)?\"?\\s+serve", "role": "devserver", "title": "Angular dev server", "what": "Đang chạy ứng dụng Angular {project} để xem thử" },
      { "name": "node|ng", "cmdRegex": "ng(?:\\.js)?\"?\\s+(?:build|test)|\\bngc\\b", "role": "build", "title": "Build Angular", "what": "Đang build dự án Angular {project}" },
      { "name": "node", "cmdRegex": "vite(?:\\.js)?\"?\\s+build", "role": "build", "title": "Build Vite", "what": "Đang build dự án {project}" },
      { "name": "node", "cmdRegex": "[\\\\/]vite(?:[\\\\/]|\\.js|\"?\\s|\"?$)", "role": "devserver", "title": "Vite dev server", "what": "Đang chạy ứng dụng {project} để xem thử" },
      { "name": "node", "cmdRegex": "tsserver", "role": "langserver", "title": "Dịch vụ ngôn ngữ TypeScript", "what": "Gợi ý code và báo lỗi TypeScript cho trình soạn thảo" },
      { "name": "node", "cmdRegex": "webpack|\\btsc\\b", "role": "build", "title": "Build web", "what": "Đang đóng gói dự án {project}" },
      { "name": "node|npm*|npx*|pnpm*", "cmdRegex": "(?:npm|pnpm|npx|yarn)\\S*\\s+(?:run(?:-script)?\\s+)?(start|dev|serve|watch|build|test)\\b", "role": "packagemgr", "title": "Lệnh npm", "what": "Đang chạy script \"{arg}\" của dự án {project}" },
      { "name": "node", "role": "runtime-app", "title": "Ứng dụng Node.js", "what": "Chương trình Node.js của dự án {project}" },
      { "name": "msedge*|chrome*|firefox*|brave*", "role": "browser", "title": "Trình duyệt", "what": "Các tab và tiện ích đang mở" },
      { "name": "code|cursor", "role": "editor", "title": "Trình soạn thảo code", "what": "Cửa sổ và tiện ích của trình soạn thảo" },
      { "name": "devenv|rider64", "role": "editor", "title": "IDE", "what": "Môi trường lập trình đang mở" },
      { "name": "msmpeng|nissrv", "role": "security", "title": "Windows Defender", "what": "Quét virus nền của Windows" },
      { "name": "memcompression|memory compression", "role": "system", "title": "Nén bộ nhớ", "what": "Windows nén bộ nhớ ít dùng để tiết kiệm RAM" },
      { "name": "svchost", "role": "system", "title": "Dịch vụ Windows", "what": "Chạy các dịch vụ nền của Windows" },
      { "name": "sqlservr", "role": "infra", "title": "SQL Server", "what": "Cơ sở dữ liệu SQL Server cục bộ" },
      { "name": "vmmem*|vmwp|vmcompute", "role": "infra", "title": "Máy ảo (WSL/Docker)", "what": "Bộ nhớ dành cho WSL hoặc Docker" },
      { "name": "docker*|com.docker*|wsl*", "role": "infra", "title": "Docker / WSL", "what": "Dịch vụ container chạy nền" },
      { "name": "ollama*", "role": "infra", "title": "Ollama (model AI cục bộ)", "what": "Chạy model AI trên máy này; thường giữ nhiều RAM khi model đang nạp" },
      { "name": "claude*|codex*|gemini|cursor-agent|copilot|opencode|goose|goosed|aider", "role": "agent", "title": "Trợ lý AI", "what": "Phiên làm việc của trợ lý AI" }
    ]
  },
  "cleanup": {
    "workspaceRoots": ["%USERPROFILE%\\Work\\Repositories", "%USERPROFILE%\\Workspace", "%USERPROFILE%\\source\\repos", "%USERPROFILE%\\repos", "%USERPROFILE%\\Projects"],
    "maxDepth": 6,
    "minAgeDays": { "dotnet-artifact": 14, "node_modules": 30, "temp-entry": 14 },
    "cacheMinInactiveDays": 14,
    "tempRoot": "",
    "tempExclude": ["claude*", "codex*", "gemini*", "cursor*"],
    "tempTop": 30,
    "minCacheMB": 100,
    "youngMinMB": 100,
    "heldProbe": true,
    "cacheDirs": {
      "nuget-packages":   "%USERPROFILE%\\.nuget\\packages",
      "nuget-http-cache": "%LOCALAPPDATA%\\NuGet\\v3-cache",
      "npm-cache":        "%LOCALAPPDATA%\\npm-cache",
      "pnpm-store":       "%LOCALAPPDATA%\\pnpm\\store",
      "pnpm-cache":       "%LOCALAPPDATA%\\pnpm-cache",
      "cursor-cache":     "%APPDATA%\\Cursor\\Cache",
      "yarn-cache":       "%LOCALAPPDATA%\\Yarn\\Cache",
      "pip-cache":        "%LOCALAPPDATA%\\pip\\Cache"
    },
    "staleRepo": { "minInactiveDays": 90, "minMB": 50 },
    "largeItem": {
      "roots": ["%USERPROFILE%\\Downloads", "%USERPROFILE%\\Videos"],
      "minMB": 500,
      "minInactiveDays": 60
    },
    "apps": {
      "roots": ["%ProgramFiles%", "%ProgramFiles(x86)%", "%LOCALAPPDATA%\\Programs"],
      "minMB": 300,
      "minInactiveDays": 180,
      "exclude": ["Windows*", "Microsoft.NET*", "Microsoft Shared*", "Microsoft Update*", "Microsoft Edge*", "Common Files", "Internet Explorer", "dotnet", "Reference Assemblies", "Uninstall Information", "ModifiableWindowsApps", "WindowsApps", "PackageManagement", "IIS*", "Application Verifier", "MSBuild", "Git", "PowerShell*"]
    },
    "vhdxGlobs": [
      "%LOCALAPPDATA%\\Packages\\*\\LocalState\\*.vhdx",
      "%LOCALAPPDATA%\\Docker\\wsl\\*.vhdx",
      "%LOCALAPPDATA%\\Docker\\wsl\\*\\*.vhdx"
    ]
  },
  "protected": {
    "segments": [".git", ".claude", ".codex", ".gemini", ".cursor", ".copilot", ".codeium", ".ollama", ".ssh", ".aws", ".azure", "Documents", "Desktop", ".agent-resource"]
  }
}
